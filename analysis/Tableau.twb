          <datasource-dependencies datasource='federated.0yav1oi1i4h2jg10482qn05z19b8'>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column caption='Safe_Formula_Flag' datatype='string' name='[Calculation_1505569774735360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Contains_Drying_Alcohol] = FALSE &#13;&#10;   AND [Contains_Synthetic_Fragrance] = FALSE &#13;&#10;   AND [Contains_Essential_Oils] = FALSE &#13;&#10;   AND [Contains_Harsh_Surfactants] = FALSE &#13;&#10;THEN &quot;Clean / Irritant-Free&quot;&#13;&#10;ELSE &quot;Contains Irritants&quot;&#13;&#10;END' />
            </column>
            <column caption='Composite_Score_Calc' datatype='real' name='[Calculation_1505569775357953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(0.50 * ([Rating] / 5.0)) + &#13;&#10;(0.30 * (LN(1 + [Review_Count]) / { FIXED : MAX(LN(1 + [Review_Count])) })) + &#13;&#10;(0.20 * (1 - (([Current Price] - { FIXED : MIN([Current Price]) }) / ({ FIXED : MAX([Current Price]) } - { FIXED : MIN([Current Price]) }))))' />
            </column>
            <column caption='Category Standardized' datatype='string' name='[Category_Standardized]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Concern Acne' datatype='integer' name='[Concern_Acne]' role='dimension' type='ordinal' />
