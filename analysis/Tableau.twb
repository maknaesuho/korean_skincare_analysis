            <column caption='Contains Synthetic Fragrance' datatype='boolean' name='[Contains_Synthetic_Fragrance]' role='dimension' type='nominal' />
            <column datatype='real' name='[Current Price]' role='measure' type='quantitative' />
            <column datatype='string' name='[Product Name]' role='dimension' type='nominal' />
            <column datatype='real' name='[Rating]' role='measure' type='quantitative' />
            <column caption='Review Count' datatype='real' name='[Review_Count]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Skin Type Dry' datatype='integer' name='[Skin_Type_Dry]' role='dimension' type='ordinal' />
